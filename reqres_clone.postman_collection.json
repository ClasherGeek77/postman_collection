          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.expect(pm.response.code).to.equal(201));",
                  "pm.test(\"has id\", () => pm.expect(pm.response.json().id).to.be.a(\"string\"));",
                  "pm.test(\"has createdAt\", () => pm.expect(pm.response.json().createdAt).to.be.a(\"string\"));"
