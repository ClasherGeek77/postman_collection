    {
      "name": "CHAIN",
      "item": [
        {
          "name": "Chain 01 plan",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/users/2",
            "description": "ported from the Bruno collection"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.variables.set(\"plan_name\", \"chain-morpheus\");",
                  "pm.variables.set(\"plan_job\", \"chain-leader\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.expect(pm.response.code).to.equal(200));",
                  "pm.test(\"clone reachable\", () => pm.expect(pm.response.json().data.id).to.equal(2));"
                ]
              }
            }
          ]
        },
        {
          "name": "Chain 02 create",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "disabled": false
              }
            ],
            "url": "{{base_url}}/api/users",
            "description": "ported from the Bruno collection",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{plan_name}}\",\n  \"job\": \"{{plan_job}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.variables.set(\"new_user_id\", pm.response.json().id);",
                  "pm.test(\"status 201\", () => pm.expect(pm.response.code).to.equal(201));",
                  "pm.test(\"job echoes plan\", () => pm.expect(pm.response.json().job).to.equal(\"chain-leader\"));",
                  "pm.test(\"name echoes plan\", () => pm.expect(pm.response.json().name).to.equal(\"chain-morpheus\"));",
                  "pm.test(\"id issued\", () => pm.expect(pm.response.json().id).to.be.a(\"string\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Chain 03 readback id",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/users?page={{new_user_id}}",
            "description": "ported from the Bruno collection"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.expect(pm.response.code).to.equal(200));",
                  "pm.test(\"captured id resolved\", () => pm.expect(pm.response.json().page).to.be.above(2));",
                  "pm.test(\"clamped page empty\", () => pm.expect(pm.response.json().data.length).to.equal(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "Chain 04 update",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "disabled": false
              }
            ],
            "url": "{{base_url}}/api/users/{{new_user_id}}",
            "description": "ported from the Bruno collection",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"chain-trinity\",\n  \"job\": \"chain-leader\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.expect(pm.response.code).to.equal(200));",
                  "pm.test(\"updatedAt\", () => pm.expect(pm.response.json().updatedAt).to.be.a(\"string\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Chain 05 delete",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{base_url}}/api/users/{{new_user_id}}",
            "description": "ported from the Bruno collection"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 204\", () => pm.expect(pm.response.code).to.equal(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Chain 06 readback stateless",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/users/{{new_user_id}}",
            "description": "ported from the Bruno collection"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.expect(pm.response.code).to.equal(200));",
                  "pm.test(\"nothing persisted (live semantics)\", () => pm.expect(pm.response.json().data.first_name).to.equal(\"Eve\"));",
                  "pm.test(\"chain var still resolves\", () => pm.expect(pm.response.json().data.id).to.equal(4));"
                ]
              }
            }
          ]
        }
      ]
    }
